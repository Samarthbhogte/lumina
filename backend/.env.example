# Copy to backend/.env and fill in. Never commit the real file.

# Which AI provider to use: gemini (free tier available) or openai.
LUMINA_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional overrides. Models default per provider:
#   gemini -> gemini-flash-latest + gemini-embedding-001
#   openai -> gpt-4o-mini + text-embedding-3-small
# LUMINA_CHAT_MODEL=
# LUMINA_EMBEDDING_MODEL=
# LUMINA_CORS_ORIGINS=http://localhost:3000
# LUMINA_MAX_UPLOAD_MB=25
# LUMINA_TOP_K=6
