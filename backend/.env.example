# Copy to backend/.env and fill in. Never commit the real file.

# Which AI provider to use: gemini (free tier available) or openai.
LUMINA_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional overrides. Models default per provider:
#   gemini -> gemini-2.5-flash + gemini-embedding-001
#   openai -> gpt-4o-mini + text-embedding-3-small
# LUMINA_CHAT_MODEL=
# LUMINA_EMBEDDING_MODEL=
# LUMINA_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # or none
# LUMINA_CORS_ORIGINS=http://localhost:3000
# LUMINA_MAX_UPLOAD_MB=25
# LUMINA_TOP_K=6

# ---- accounts ----
# invite (default): only the first person can sign up without an invite link.
# LUMINA_SIGNUP=invite
# Set true when Lumina is served over HTTPS.
# LUMINA_COOKIE_SECURE=false
# Browser origins allowed to make changes (the web app's address).
# LUMINA_TRUSTED_ORIGINS=http://localhost:3000
# Daily AI questions per user and in total (free tiers are small).
# LUMINA_DAILY_QUESTIONS_PER_USER=25
# LUMINA_DAILY_QUESTIONS_TOTAL=55
# Read scanned PDFs with Tesseract when installed (auto) or never (off).
# LUMINA_OCR=auto
